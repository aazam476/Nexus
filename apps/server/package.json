{
  "name": "@nexus/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "prisma generate"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "^14.0.3",
    "bullmq": "^5.81.5",
    "fast-xml-parser": "5.11.2",
    "fastify": "^5.12.7",
    "imapflow": "^1.7.8",
    "ioredis": "^5.11.1",
    "mailparser": "^3.9.46",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  }
}
