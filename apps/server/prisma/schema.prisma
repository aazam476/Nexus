// Nexus database. Read top to bottom: people, their mail accounts, the mail, then everything around it.
// Secrets (mail passwords, OAuth tokens, TOTP secrets, plugin settings, S/MIME keys) are stored
// encrypted with APP_SECRET; see src/lib/crypto.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- People ----------

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  role              String   @default("user") // "admin" | "user"
  totpSecret        String? // encrypted
  totpEnabled       Boolean  @default(false)
  totpLastStep      Int? // the 30-second step of the last code used, so the same code can't be used twice
  recoveryCodes     String[] // sha256 hashes, removed once used
  // Private storage (see src/lib/sealed.ts). Keys are kept after it is turned off, so nothing becomes unreadable.
  privateStorage    Boolean  @default(false)
  storagePublicKey  String?
  storagePrivateKey String? // locked with the user's password
  createdAt         DateTime @default(now())

  sessions       Session[]
  accounts       Account[]         @relation("owner")
  sharedAccounts AccountMember[]
  contacts       Contact[]
  rules          Rule[]
  blockedSenders BlockedSender[]
  labels         Label[]
  pgpKeys        PgpKey[]
  smimeCerts     SmimeCert[]
  plugins        PluginSetting[]
  outgoing       OutgoingMessage[]
  feeds          Feed[]
  preference     Preference?
}

model Session {
  id         String   @id // sha256 of the cookie token, so a database leak can't be replayed
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pending2fa Boolean  @default(false) // password checked, TOTP code not yet
  storageKey String? // the user's private-storage key, locked with this session's cookie token
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
}

// ---------- Mail accounts ----------

model Account {
  id         String    @id @default(cuid())
  ownerId    String
  owner      User      @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  email      String
  name       String
  color      String
  protocol   String // "imap" | "pop3"
  auth       String // "password" | "oauth-google" | "oauth-microsoft"
  inHost     String
  inPort     Int
  inTls      Boolean // true = TLS from the start, false = STARTTLS
  smtpHost   String
  smtpPort   Int
  smtpTls    Boolean
  username   String
  secret     String // encrypted password, or OAuth refresh token
  // Only for servers where sending needs a different login than receiving (some hosts and mail relays).
  smtpUsername String?
  smtpSecret   String? // encrypted password for smtpUsername
  signature  String    @default("")
  lastSyncAt DateTime?
  syncError  String?
  createdAt  DateTime  @default(now())

  members  AccountMember[]
  folders  Folder[]
  messages Message[]
}

// Sharing: other users who can use this account. The owner is not listed here.
model AccountMember {
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "editor" | "viewer"

  @@id([accountId, userId])
}

model Folder {
  id            String  @id @default(cuid())
  accountId     String
  account       Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  path          String // name on the IMAP server; POP3 accounts use local paths
  role          String // "inbox" | "sent" | "drafts" | "archive" | "spam" | "trash"
  uidValidity   BigInt?
  lastUid       Int     @default(0)
  // Everything from this UID up has been downloaded; older mail is fetched a batch per sync until it's 1.
  oldestUid     Int?
  // Change counter (IMAP CONDSTORE) and message count at the last sync; if neither moved, nothing changed.
  highestModseq BigInt?
  lastExists    Int?

  messages Message[]

  @@unique([accountId, path])
  @@unique([accountId, role])
}

// ---------- Mail ----------

model Message {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folderId      String
  folder        Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uid           Int? // IMAP UID inside the folder
  remoteId      String? // POP3 UIDL
  messageId     String? // the Message-ID header
  fromName      String
  fromEmail     String
  to            Json // [{ name, email }]
  cc            Json
  subject       String
  preview       String
  text          String?
  html          String?
  date          DateTime
  unread        Boolean  @default(true)
  starred       Boolean  @default(false)
  category      String // "people" | "travel" | "notifications" | "newsletters"
  labels        String[]
  attachments   Json // [{ id, filename, contentType, size }]; content stays in `raw`
  security      String?
  event         Json?
  raw           Bytes // the full original message (empty when sealed)
  // Private storage: when set, raw/html/text/preview/attachments/event are inside these instead.
  sealedSummary Bytes? // preview, attachments, event: small, opened for every list row
  sealedBody    Bytes? // raw, html, text: opened only when the message is read
  createdAt     DateTime @default(now())

  // Full-text search: Postgres keeps this up to date from subject, sender and text (see the init migration).
  search Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('simple'::regconfig, COALESCE(subject, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, ((COALESCE(\"fromName\", ''::text) || ' '::text) || COALESCE(\"fromEmail\", ''::text))), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(text, ''::text)), 'C'::\"char\"))"))

  @@unique([folderId, uid])
  @@unique([accountId, remoteId])
  @@index([accountId, folderId, date])
  @@index([search], type: Gin)
}

// Mail written in Nexus that is not on the server yet: drafts and scheduled sends.
model OutgoingMessage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  status       String // "draft" | "scheduled" | "sending" | "sent" | "failed"
  payload      Json // what the composer sent: recipients, subject, html, attachments, security options
  scheduledFor DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Around the mail ----------

model Contact {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  emails         String[]
  phone          String?
  company        String?
  pgpPublicKey   String?
  pgpFingerprint String?
  smimeCert      String? // PEM, collected from their signed mail
  messageCount   Int      @default(0)
  createdAt      DateTime @default(now())
}

model Rule {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  field    String // "from" | "to" | "subject" | "body"
  contains String
  action   String // "label" | "move" | "category" | "mark-read" | "spam"
  value    String?
  enabled  Boolean @default(true)
  position Int     @default(0)
}

model BlockedSender {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern String // an address or a whole domain

  @@id([userId, pattern])
}

model Label {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  color  String

  @@id([userId, name])
}

model PgpKey {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint         String
  userIds             String[]
  publicKey           String
  encryptedPrivateKey String // armored and passphrase-locked in the browser; the server can't open it
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
}

model SmimeCert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  subject   String
  certPem   String
  keyPem    String // encrypted
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PluginSetting {
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluginId String
  enabled  Boolean @default(false)
  settings String // encrypted JSON

  @@id([userId, pluginId])
}

// One row of user preferences that don't deserve their own table.
model Preference {
  userId            String @id
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String @default("system")
  layout            String @default("three-pane")
  spamThreshold     Float  @default(5)
  // Delete feed posts older than this many days (starred ones are kept). Empty: keep everything.
  feedRetentionDays Int?
}

// ---------- Feeds (RSS and Atom) ----------

// A feed someone subscribed to. Each user has their own list.
model Feed {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String // the feed's own address (found from the website's page if needed)
  title         String
  siteUrl       String? // the website the feed belongs to
  lastFetchedAt DateTime?
  error         String? // why the last refresh failed, shown in the app
  createdAt     DateTime   @default(now())
  items         FeedItem[]

  @@unique([userId, url])
}

// One post from a feed.
model FeedItem {
  id          String   @id @default(cuid())
  feedId      String
  feed        Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  guid        String // the feed's own id for the post (or its link), so it's never stored twice
  title       String
  link        String?
  author      String?
  content     String // HTML from the feed; the web app sanitizes it before showing it (SafeHtml)
  summary     String // the start as plain text, for the list
  publishedAt DateTime
  unread      Boolean  @default(true)
  starred     Boolean  @default(false) // starred posts are kept even when old posts are deleted

  @@unique([feedId, guid])
  @@index([feedId, publishedAt])
}
