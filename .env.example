# Required. A long random string; encrypts stored passwords and tokens. Generate with:
#   openssl rand -base64 48
APP_SECRET=

# The address people use to reach Nexus (used for cookies and OAuth redirects).
PUBLIC_URL=http://localhost:8080

# Let anyone with the URL create an account after the first (admin) user. Admins can always add users.
ALLOW_SIGNUP=false

# Accept self-signed certificates on your mail server (only for a server on your own network).
MAIL_ALLOW_INSECURE_TLS=false

# Optional: sign in with Google / Microsoft mail accounts (OAuth2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Database password used by docker-compose.yml.
POSTGRES_PASSWORD=change-me
